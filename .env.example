# RepoRadar V3 — environment variables
# Copy this to .env and fill in your values.
# Tokens/credentials are NEVER committed.

# ---------------------------------------------------------------------------
# LLM Judge (required for `judge` step)
# Set ONE of these:
GEMINI_API_KEY=
# GOOGLE_API_KEY=        # alternative to GEMINI_API_KEY

# Optional: model override (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Fallback LLM when Gemini is unavailable:
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Email digest (required for `finalize` → email step)
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=        # Gmail App Password (not your account password)


